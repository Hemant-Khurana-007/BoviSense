# Add these values in Render's Environment settings. Never commit a real .env.
SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer the server-side Secret key. A publishable key requires a restrictive
# RLS policy that allows this server to select public.cows.
SUPABASE_SECRET_KEY=sb_secret_replace_me
SUPABASE_COWS_TABLE=cows
